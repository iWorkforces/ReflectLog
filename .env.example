OPENROUTER_API_KEY=sk-or-v1-XXX             # OpenRouter API key (required)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Configuration Preset
# Quick configuration setup (overrides individual settings below)
# Options: simple, balanced (default), performance, quality
REFLECTLOG_PROFILE=balanced                    # Preset selection

# Transport Configuration
MCP_TRANSPORT=http                             # Transport protocol: stdio, http, sse, streamable-http (default: stdio)
MCP_PORT=9103                                  # Server port for non-stdio transports (default: 9103)
MCP_HOST=127.0.0.1                             # Server host (default: 127.0.0.1)
MCP_PATH=/mcp                                  # Server path (default: /mcp)

# Authentication & Authorization Configuration (for HTTP transport)
# Controls access to HTTP transport endpoints
ENABLE_HTTP_AUTH=false                   # Enable HTTP authentication (default: false)
HTTP_AUTH_TOKEN=XXX-XXX-XXX-XXX-XXX      # Shared secret token for HTTP auth (default: none)
# Note: When ENABLE_HTTP_AUTH=true, clients must provide HTTP_AUTH_TOKEN in header
# Options: Bearer token, API key, or custom header
# For production, use API gateway/reverse proxy with authentication

# Security Headers Configuration (for HTTP transport)
# Controls security headers to prevent XSS, clickjacking, and other attacks
ENABLE_CORS=false                       # Enable CORS for cross-origin requests (default: false)
CORS_ALLOW_ORIGINS=*                   # Allowed origins for CORS (default: * = all)
# Use specific origins in production: https://yourdomain.com
CORS_ALLOW_METHODS=POST,GET            # Allowed HTTP methods (default: POST,GET)
CORS_ALLOW_HEADERS=Content-Type,Authorization  # Allowed headers in requests (default: Content-Type,Authorization)
ENABLE_CSP=false                        # Enable Content-Security-Policy header (default: false)
CSP_DIRECTIVES=default-src 'self'  # CSP directives (default: default-src 'self')
# Note: These headers are recommendations; actual enforcement depends on deployment

# Audit Logging Configuration
# Tracks user actions, IP addresses, timestamps for security analysis
ENABLE_AUDIT_LOGGING=true               # Enable audit logging (default: true)
AUDIT_LOG_LEVEL=INFO                      # Audit log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
AUDIT_LOG_FILE=logs/audit.log           # Audit log file path (default: logs/audit.log)
AUDIT_LOG_MAX_SIZE_MB=10                 # Max log file size before rotation (default: 10 MB)
AUDIT_LOG_RETENTION_DAYS=30               # Days to keep audit logs (default: 30)
# Note: Audit logs track all API calls with context for security investigation

# Dependency Vulnerability Scanning Configuration
# Automated security checks for third-party packages
ENABLE_DEP_SCAN=false                 # Enable dependency vulnerability scanning (default: false)
DEP_SCAN_TOOL=audity                    # Scanning tool: safety, audit (default: audity)
DEP_SCAN_SCHEDULE=weekly               # Scan schedule: daily, weekly, monthly (default: weekly)
# Note: Scans run on demand via scan-dependencies.sh script
# Recommended: Enable DEP_SCAN=true in CI/CD for security

# Rate Limiting Configuration (for HTTP transport)
# Prevents API abuse and ensures fair resource allocation
API_RATE_LIMIT=100                          # Max API requests per minute per client (default: 100)
API_RATE_BURST=200                          # Burst capacity for rate limiting (default: 200)
# Note: These limits should be enforced by API gateway or reverse proxy in production

# HTTP Connection Pool Configuration
# Optimizes HTTP client performance by reusing TCP connections
HTTP_MAX_CONNECTIONS=100                   # Maximum total connections (default: 100)
HTTP_MAX_KEEPALIVE_CONNECTIONS=20         # Maximum keepalive connections (default: 20)
HTTP_CONNECT_TIMEOUT=30.0                   # Connection timeout in seconds (default: 30.0)
HTTP_READ_TIMEOUT=30.0                      # Read timeout in seconds (default: 30.0)
HTTP_WRITE_TIMEOUT=30.0                     # Write timeout in seconds (default: 30.0)
# Note: Higher connection limits reduce TCP handshake overhead but increase memory usage
# Note: Keepalive connections improve performance by reusing established TCP connections

# Tantivy Soft-Delete Configuration (O(1) delete vs O(n) rebuild)
TANTIVY_SOFT_DELETE_ENABLED=true       # Use tombstone marking instead of index rebuild (default: true)
TANTIVY_COMPACTION_THRESHOLD_RATIO=0.2 # Compact when tombstones > 20% of live docs (default: 0.2)
TANTIVY_COMPACTION_MAX_TOMBSTONES=10000 # Force compaction above this tombstone count (default: 10000)
TANTIVY_TOMBSTONE_TTL_DAYS=7           # Days before tombstones eligible for removal (default: 7)

# USearch Exact vs Approximate Search Configuration
USEARCH_EXACT_SEARCH=false           # Force exact brute-force search (default: false)
                                     # When true: bypasses HNSW, uses SIMD-optimized SimSIMD
                                     # When false: uses approximate HNSW search (faster for large collections)
USEARCH_EXACT_SEARCH_THRESHOLD=256       # Auto-switch to exact search when index size < threshold (default: 256)
                                     # Example: set to 10000 to use exact search for small indices

# Fusion Configuration (ranx-based)
ENABLE_RRF_FUSION=true               # Enable RRF fusion for hybrid search (default: true)
                                     # When true: combines semantic + full-text results using RRF algorithm
                                     # When false: concatenates results (semantic first, then full-text deduped)
FUSION_METHOD=rrf                    # Fusion method: rrf, sum, mnz, max, bordafuse (default: rrf)
FUSION_RRF_K=60                      # RRF k parameter, lower = more weight to top ranks (default: 60)
FUSION_RANKING_THRESHOLD=0.8         # Min normalized RRF score to keep results (default: 0.8)
                                     # Note: Only applied when ENABLE_RRF_FUSION=true
#FUSION_WEIGHTS=1.0,0.5                # Optional per-source weights for weighted RRF (default: equal weights)
                                      # When set: applies weights to each search backend's RRF contribution
                                      # Must have 2+ comma-separated floats matching number of backends
                                      # Example: 1.0,0.5 gives semantic 2x more weight than full-text

# Reranking Engine Configuration
# Set at MCP server startup via environment. Default is the local cross-encoder.
RERANKER_ENGINE=cross_encoder            # "cross_encoder" (default) or "none" to disable
                                         # cross_encoder: local FlagReranker model (no API cost)
                                         # none: fusion scores only

# Unified Reranker Settings
RERANKER_MIN_RESULTS=0                   # Safety net: min results to return (default: 0 = disabled)
                                         # When > 0: guarantees at least N results even if all below threshold
RERANKER_BATCH_NORMALIZE=true            # Enable batch min-max normalization (default: true)
                                         # Transforms scores to [0, 1] range (best=1.0, worst=0.0)

# Temporal-Aware Reranking Configuration
ENABLE_RECENCY_BOOST=true                # Multiply rerank scores by recency decay (default: true)
RECENCY_DECAY_RATE=0.01                  # Exponential decay rate per hour (default: 0.01)
                                         # Formula: score * exp(-rate * hours_old)
                                         # 0.01 = ~50% decay at 69 hours, ~10% at 230 hours

# LLM settings used by smart replacement (not search reranking)
LLM_MODEL=x-ai/grok-4.1-fast             # LLM model for smart replacement
RERANK_MAX_CONCURRENCY=10                # Max parallel LLM calls for smart replacement

# Concurrency Configuration
ADD_MAX_CONCURRENCY=4                        # Max concurrent message additions in Phase 1 (default: 4)
API_RATE_LIMIT=100                          # Max API requests per minute per client (default: 100)
API_RATE_BURST=200                          # Burst capacity for rate limiting (default: 200)
                                             # Controls parallelism for duplicate detection and smart replacement

# Initialization Configuration
EAGER_INITIALIZATION=true                    # Pre-warm engines during MemoryManager init (default: true)
                                             # When true: USearch + Tantivy + embeddings initialized at startup
                                             # When false: lazy initialization on first use (faster startup)

# Logging Configuration
LOG_LEVEL=INFO                               # Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_SEARCH_RESULTS_VERBOSE=false             # Log individual search results (default: false)
LOG_SEARCH_RESULT_LIMIT=3                    # Max results to log when verbose enabled (default: 3)

ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_AUTH_TOKEN=sk-or-v1-XXX                 # Automatic if use with standard Claude Code auth
ANTHROPIC_MODEL=glm-5
