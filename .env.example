OPENROUTER_API_KEY=sk-or-v1-XXX-58b            # OpenRouter API key (required)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Transport Configuration
MCP_TRANSPORT=http                             # Transport protocol: stdio, http, sse, streamable-http (default: stdio)
MCP_PORT=9103                                  # Server port for non-stdio transports (default: 9103)
MCP_HOST=127.0.0.1                             # Server host (default: 127.0.0.1)
MCP_PATH=/mcp                                  # Server path (default: /mcp)

# Embedding Provider Configuration
EMBEDDER_PROVIDER=langchain                    # Embedding provider: langchain or openai (default: openai)
EMBEDDING_MODEL=qwen/qwen3-embedding-8b  # Embedding model: qwen/qwen3-embedding-8b, openai/text-embedding-3-large
EMBEDDING_DIMS=3072                            # OpenAI embedding dimensions (default: 3072)
QWEN_EMBEDDING_DIMS=4096                       # Qwen embedding dimensions (default: 4096)

# Embedding Performance Configuration
EMBEDDING_BATCH_SIZE=512                       # Texts per API request for async batching (default: 512)
EMBEDDING_MAX_CONCURRENT_BATCHES=4             # Max parallel batch requests (default: 4)
EMBEDDING_CACHE_ENABLED=true                   # Enable LRU cache for query embeddings (default: true)
EMBEDDING_CACHE_SIZE=100                       # Max cached embeddings (default: 100)

# Tool Registration Configuration
ALLOWED_TOOLS=add,get_all,search,remove         # Comma-separated tool names (use "*" for all, "none" to disable)

# Memory Search Configuration
SEARCH_LIMIT=5                    # Max semantic search results (default: 5)
REMOVE_SEARCH_LIMIT=5             # Max candidates when searching for removal (default: 5)

# LLM Inference Configuration
ENABLE_LLM_INFER=false             # Enable LLM processing of messages during add (default: false)
                                   # When true: messages are transformed by LLM (e.g., "Python tutorial" → "User is interested in Python tutorial")
                                   # When false: messages are stored exactly as provided (faster, no LLM calls)

# Message Validation Constraints
MAX_MESSAGE_LENGTH=30720           # Maximum characters per message (default: 30720)
MIN_MESSAGE_LENGTH=1               # Minimum characters per message (default: 1)
DEDUPLICATE_MESSAGES=true          # Skip storing messages that already exist verbatim (default: true)

# Smart Memory Replacement Configuration
ENABLE_SMART_REPLACE=true          # Enable LLM-based smart memory replacement (default: true)
                                   # When true: detects if new memory replaces existing one (e.g., "I like cats" → "I don't like cats anymore")
                                   # When false: memories are added without replacement detection
SMART_REPLACE_THRESHOLD=0.7        # Min LLM confidence to trigger replacement (default: 0.7)
                                   # Higher = stricter (fewer replacements), Lower = more permissive
SMART_REPLACE_MIN_SIMILARITY=0.9   # Min embedding similarity to trigger LLM check (default: 0.9)
                                   # Memories below this similarity skip LLM call entirely (saves cost/latency)
SMART_REPLACE_CANDIDATE_LIMIT=3    # Max candidates to check for replacement (default: 3)
                                   # Higher = catches more related memories, but more LLM calls
SMART_REPLACE_ARCHIVE_TTL_DAYS=30  # Days to keep archived (replaced) memories (default: 30, 0 = permanent)
                                   # Enables recovery from LLM mistakes
SMART_REPLACE_MAX_RETRIES=3        # Max LLM call retries on failure (default: 3)
SMART_REPLACE_RETRY_DELAY=1.0      # Base delay in seconds for exponential backoff (default: 1.0)
SMART_REPLACE_PROVIDER=openai      # LLM provider for smart replacement: "openai" or "anthropic" (default: openai)
                                   # openai: Uses OpenRouter API with structured JSON output
                                   # anthropic: Uses Claude Agent SDK via ccmemories.utility.generate_content()

# Hybrid Search Configuration
ENABLE_HYBRID_SEARCH=true              # Enable hybrid USearch+Tantivy search (default: true)

# Overfetch Configuration (adaptive multiplier for better fusion)
OVERFETCH_MULTIPLIER=3                 # Base multiplier for fetching candidates (default: 3)
OVERFETCH_ADAPTIVE=true                # Enable adaptive overfetch based on index size (default: true)
OVERFETCH_MIN_MULTIPLIER=1.5           # Min multiplier for large indexes ≥10k docs (default: 1.5)
OVERFETCH_MAX_MULTIPLIER=3.0           # Max multiplier for small indexes ≤100 docs (default: 3.0)

# Tantivy Soft-Delete Configuration (O(1) delete vs O(n) rebuild)
TANTIVY_SOFT_DELETE_ENABLED=true       # Use tombstone marking instead of index rebuild (default: true)
TANTIVY_COMPACTION_THRESHOLD_RATIO=0.2 # Compact when tombstones > 20% of live docs (default: 0.2)
TANTIVY_COMPACTION_MAX_TOMBSTONES=10000 # Force compaction above this tombstone count (default: 10000)
TANTIVY_TOMBSTONE_TTL_DAYS=7           # Days before tombstones eligible for removal (default: 7)

# USearch Exact vs Approximate Search Configuration
USEARCH_EXACT_SEARCH=true            # Force exact brute-force search (default: true)
                                     # When true: bypasses HNSW, uses SIMD-optimized SimSIMD (best for <10k vectors)
                                     # When false: uses approximate HNSW search (faster for large collections)
USEARCH_EXACT_SEARCH_THRESHOLD=10000     # Auto-switch to exact search when index size < threshold (default: 0 = disabled)
                                     # Example: set to 10000 to use exact search for small indices

# Fusion Configuration (ranx-based)
ENABLE_RRF_FUSION=true               # Enable RRF fusion for hybrid search (default: true)
                                     # When true: combines semantic + full-text results using RRF algorithm
                                     # When false: concatenates results (semantic first, then full-text deduped)
FUSION_METHOD=rrf                    # Fusion method: rrf, sum, mnz, max, bordafuse (default: rrf)
FUSION_RRF_K=60                      # RRF k parameter, lower = more weight to top ranks (default: 60)
FUSION_RANKING_THRESHOLD=0.8         # Min normalized RRF score to keep results (default: 0.8)
                                     # Note: Only applied when ENABLE_RRF_FUSION=true

# Reranking Engine Configuration
RERANKER_ENGINE=llm                      # Reranking engine: "llm", "cross_encoder", or "none" (default: llm)
                                         # llm: Uses LLM API for semantic relevance scoring (higher quality, API cost)
                                         # cross_encoder: Uses local cross-encoder model (fast, no API cost)
                                         # none: Disables reranking (fastest, uses only fusion scores)

# Unified Reranker Settings (apply to both LLM and CrossEncoder)
RERANKER_MIN_RESULTS=0                   # Safety net: min results to return (default: 0 = disabled)
                                         # When > 0: guarantees at least N results even if all below threshold
RERANKER_BATCH_NORMALIZE=true            # Enable batch min-max normalization (default: true)
                                         # Transforms scores to [0, 1] range (best=1.0, worst=0.0)
                                         # Makes threshold semantics consistent across both rerankers

# LLM Reranking Configuration (used when RERANKER_ENGINE=llm)
LLM_MODEL=x-ai/grok-4.1-fast             # LLM model for reranking (default: x-ai/grok-4.1-fast, claude-sonnet-4-5)
SEARCH_SCORE_THRESHOLD=0.5               # Min LLM relevance score to keep results (default: 0.5)
RERANK_MAX_CONCURRENCY=10                # Max parallel LLM calls for reranking (default: 10)

# Cross-Encoder Reranking Configuration (used when RERANKER_ENGINE=cross_encoder)
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3  # HuggingFace cross-encoder model (default: BAAI/bge-reranker-v2-m3)
CROSS_ENCODER_TOP_K=20                       # Max results to return after reranking (default: 20)
CROSS_ENCODER_DEVICE=cpu                     # Inference device: "cpu", "cuda", "mps" (default: cpu)
CROSS_ENCODER_BATCH_SIZE=32                  # Batch size for inference (default: 32)
CROSS_ENCODER_SCORE_THRESHOLD=0.5            # Min cross-encoder score to keep (default: 0.5)
CROSS_ENCODER_USE_FP16=true                  # Enable FP16 for faster inference (default: true)
CROSS_ENCODER_NORMALIZE=true                 # Normalize scores to 0-1 with sigmoid (default: true)
CROSS_ENCODER_MAX_LENGTH=512                 # Max token length for query-doc pairs (default: 512)

# Concurrency Configuration
ADD_MAX_CONCURRENCY=4                        # Max concurrent message additions in Phase 1 (default: 4)
                                             # Controls parallelism for duplicate detection and smart replacement

# Initialization Configuration
EAGER_INITIALIZATION=true                    # Pre-warm engines during MemoryManager init (default: true)
                                             # When true: USearch + Tantivy + embeddings initialized at startup
                                             # When false: lazy initialization on first use (faster startup)

# Logging Configuration
LOG_LEVEL=INFO                               # Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_SEARCH_RESULTS_VERBOSE=false             # Log individual search results (default: false)
LOG_SEARCH_RESULT_LIMIT=3                    # Max results to log when verbose enabled (default: 3)
